# Dependencies
node_modules/

# Builds
dist/
build/
.next/
out/
target/
# The box-wide disk guard spares a per-worktree target, so the build lives here. `target/` above
# does not match it, and a careless `git add -A` would try to commit 30 GB of build output.
.tmp-target/
# The trailing slash above matches a **directory** only. When the build target is a SYMLINK into
# tmpfs — the pattern this box needs when `/mnt/apopic` is at 100% — a careless `git add -A`
# stages the link itself, and committing it replaces every other worker's build directory with a
# dangling pointer to a machine that may be rebooted. The unslashed form matches both.
.tmp-target
.cargo/

# Env / secrets
.env
.env.*
*.local
!.env.example

# TypeScript / Next.js
next-env.d.ts
*.tsbuildinfo
pnpm-debug.log*

# QA artifacts (screenshots + raw logs stay on disk, never in git)
qa-artifacts/
# `qa-artifacts/` above matches the DIRECTORY, so a symlink pointing at /dev/shm (which is how a
# pass keeps its screenshots off a 93%-full /mnt/apopic) does NOT match and git stages it as a
# regular file. Two lines, because git does not treat a trailing slash as "this or a link".
qa-artifacts
!qa-artifacts/

# Turbo
.turbo/

# Logs & caches
*.log
logs/
.cache/
.DS_Store

# Object storage of the development driver (crates/storage, OMNION_STORAGE_DRIVER=fs)
.omnion-media/

# Generated by `next dev` (framework agent rules)
AGENTS.md
CLAUDE.md

# The scratch target dir a writer loop uses when /mnt/apopic is tight (docs/BUILD-LOG.md).
.tmp-target/
