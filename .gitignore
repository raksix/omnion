# Dependencies
node_modules/

# Builds
dist/
build/
.next/
out/
target/
# The box-wide disk guard spares a per-worktree target, so the build lives here. `target/` above
# does not match it, and a careless `git add -A` would try to commit 30 GB of build output.
.tmp-target/
.cargo/

# Env / secrets
.env
.env.*
*.local
!.env.example

# TypeScript / Next.js
next-env.d.ts
*.tsbuildinfo
pnpm-debug.log*

# QA artifacts (screenshots + raw logs stay on disk, never in git)
qa-artifacts/

# Turbo
.turbo/

# Logs & caches
*.log
logs/
.cache/
.DS_Store

# Object storage of the development driver (crates/storage, OMNION_STORAGE_DRIVER=fs)
.omnion-media/

# Generated by `next dev` (framework agent rules)
AGENTS.md
CLAUDE.md
