# Origin of the Omnion API the renderer reads published content from. Read on the server only
# (the browser never calls the API), so the development stack needs no CORS rule.
OMNION_API_URL=http://127.0.0.1:8080

# Optional: site hint for installations where several sites share this renderer — a site key
# (`main`) or one of its domains. Unset, the visitor's own host decides, and a single-site
# installation needs nothing at all.
# OMNION_SITE=main

# Optional: absolute origin of the site, used for canonical and Open Graph URLs.
# OMNION_SITE_URL=https://example.org

# Optional: theme key to render with (`minimal` is the default).
# OMNION_WEB_THEME=minimal
