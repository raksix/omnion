  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Omnion · Outbound reliability and telemetry health",
  "uid": "7ip37g6",
  "version": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "omnion",
    "observability"
  ],
  "panels": [
    {
      "id": 26,
      "type": "stat",
      "title": "Exporter drops, 5m",
      "description": "Telemetry lost because an exporter's buffer filled. Non-zero means your monitoring has a hole in it.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "omnion-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(omnion_exporter_dropped_total[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 27,
      "type": "stat",
      "title": "Open circuits",
      "description": "Providers with an open circuit. Open is not a fault — it is what the circuit is FOR. Sustained-open is.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "omnion-prometheus"
          },
          "editorMode": "code",
          "expr": "count(omnion_circuit_state == 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 28,
      "type": "stat",
      "title": "Drains that timed out (1h)",
      "description": "Shutdowns that reached their deadline with requests still running. Exit code is 0 either way, so this is the only signal of requests being cut at deploy time.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "omnion-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(omnion_shutdowns_total{outcome=\"timed_out\"}[1h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Webhook deliveries",
      "description": "By result. A third failing is usually a misconfigured endpoint rather than a broken one.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
