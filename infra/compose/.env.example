# Omnion — small-company production stack (REQ-128, slice 1).
#
#   cp infra/compose/.env.example .env
#   # edit every value marked REQUIRED
#   docker compose -f infra/compose/docker-compose.prod.yml up -d
#
# **This file contains NO VALUES and never will.** It is the variable list, not a configuration.
# Every line marked REQUIRED is read by the stack as `${VAR:?…}`, which makes `docker compose`
# refuse to start with a named error rather than substituting an empty string — an empty database
# password is a stack that boots, connects, and is open.
#
# `.env` must be git-ignored. It is in the repository's `.gitignore` (`.env`, `.env.*` with
# `!.env.example`); verify with `git check-ignore -v .env` before the first commit that has one.
#
# How to generate the two secrets this stack cannot start without:
#   openssl rand -base64 48   # OMNION_CSRF_SECRET
#   openssl rand -base64 32   # OMNION_ADMIN_PASSWORD

# ---------------------------------------------------------------------------------------------
# Image and version
# ---------------------------------------------------------------------------------------------
# Registry the images are pulled from. The default is the project's public registry; a private
# registry is a value change and nothing else.
OMNION_IMAGE_REPO=ghcr.io/raksix/omnion
# The exact tag. A deployment pins a version, never `latest`: a rollback needs to name the
# previous image, and `latest` has no previous.
OMNION_VERSION=0.1.0

# ---------------------------------------------------------------------------------------------
# Public origin
# ---------------------------------------------------------------------------------------------
# REQUIRED. The origin browsers reach, scheme included. Used for absolute links in e-mail,
# OAuth callbacks and the public content API, so a wrong value here produces links nobody can
# follow rather than an error anyone sees.
OMNION_PUBLIC_URL=https://omnion.example.com

# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------
# REQUIRED. Both are credentials and neither has a default.
OMNION_DB_USER=omnion
OMNION_DB_PASSWORD=
OMNION_DB_NAME=omnion
# Connection budget for the API. Leave it below the server's `max_connections`: the migration
# job, the replicas and an operator's psql session all draw from the same server.
OMNION_DB_MAX_CONNECTIONS=20

# ---------------------------------------------------------------------------------------------
# Cache and queues
# ---------------------------------------------------------------------------------------------
# Redis is not published to the host in the small-company stack; the API reaches it over the
# compose network. An operator connects with `docker compose exec redis redis-cli`.
# (The value is fixed in the stack; this entry documents it for the enterprise file.)
OMNION_REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------------------------
# REQUIRED (both). The access key and the secret key for the bundled MinIO, or for an
# external S3-compatible endpoint when the enterprise stack is used instead.
OMNION_S3_ACCESS_KEY=
OMNION_S3_SECRET_KEY=
OMNION_S3_BUCKET=omnion-media
OMNION_S3_REGION=us-east-1
# For the enterprise topology, point the API at an external endpoint instead:
# OMNION_S3_ENDPOINT=https://s3.example.com

# ---------------------------------------------------------------------------------------------
# Secrets — REQUIRED, no development default
# ---------------------------------------------------------------------------------------------
# HMAC key for CSRF tokens. An instance that boots with the development default accepts a
# forged cross-site request from any origin, so this is `:?` in the stack.
OMNION_CSRF_SECRET=

# The first administrator, created on the first boot. The password is only read when the
# database has no administrator yet, so changing it later does not reset an existing account.
OMNION_ADMIN_EMAIL=
OMNION_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Published host ports
# ---------------------------------------------------------------------------------------------
OMNION_API_PORT=8080
OMNION_ADMIN_PORT=3000
OMNION_WEB_PORT=3001

# ---------------------------------------------------------------------------------------------
# Lifecycle
# ---------------------------------------------------------------------------------------------
# How long the API may take to drain in-flight requests after SIGTERM. It must fit inside
# OMNION_STOP_GRACE_PERIOD with room for the telemetry flush that follows, so the grace period
# is set ABOVE it rather than equal to it.
OMNION_DRAIN_TIMEOUT_MS=10000
# The container's termination grace period, which is what the orchestrator actually enforces.
OMNION_STOP_GRACE_PERIOD=30s

# ---------------------------------------------------------------------------------------------
# Resource hints
# ---------------------------------------------------------------------------------------------
# Per-service CPU limits as a fraction of a core, and memory ceilings. These are limits, not
# reservations: compose does not reserve, so a small host will simply never reach them.
OMNION_API_CPUS=2.0
OMNION_API_MEMORY=1g
OMNION_ADMIN_CPUS=1.0
OMNION_ADMIN_MEMORY=768m
OMNION_WEB_CPUS=1.0
OMNION_WEB_MEMORY=768m

# ---------------------------------------------------------------------------------------------
# Enterprise topology (docker-compose.enterprise.yml ONLY)
# ---------------------------------------------------------------------------------------------
# `docker-compose.enterprise.yml` runs against services this machine does not host. Every one
# of these three is REQUIRED by that stack and none of them is read by the small-company stack
# above, which is why they live in their own section instead of being merged into the database
# and object-store sections: an operator reading this file should not conclude that filling
# them in is part of a single-host install.
#
# They were absent from this list until the bundle generator (REQ-128 slice 3) compared the
# stack's `${…}` references against the declarations here and refused the difference. The
# failure they caused was the worst kind for a first install: the stack refused to start with
# "required variable OMNION_EXTERNAL_POSTGRES_DSN is missing" and the operator's next question
# — "missing from where?" — had no answer in any file they had been given.
#
# Leave them EMPTY in a single-host install. `docker-compose.prod.yml` does not read them.
OMNION_EXTERNAL_POSTGRES_DSN=
OMNION_EXTERNAL_REDIS_URL=
OMNION_EXTERNAL_S3_ENDPOINT=
OMNION_API_REPLICAS=3
OMNION_ADMIN_REPLICAS=2
OMNION_WEB_REPLICAS=2

# ---------------------------------------------------------------------------------------------
# Observability (optional profile)
# ---------------------------------------------------------------------------------------------
# The observability bundle (REQ-126) ships a profile file that scrapes `/metrics` off this
# stack. Enable it with:
#   docker compose -f docker-compose.prod.yml -f docker-compose.observability.yml up -d
# It reads the API's published port; the prometheus instance is not published to the host
# unless you choose to, which is the default here.
