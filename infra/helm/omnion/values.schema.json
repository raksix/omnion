{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Omnion chart values",
  "description": "Structural contract for the Omnion chart's values. The point of a schema is that a typo is an install-time error naming the field, not a silently-ignored key: Helm applies whatever it does not recognise and the operator finds out from a pod that will not start.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "secrets", "api"],
  "definitions": {
    "quantity": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" }
      ]
    },
    "resourceBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/quantity" }
        },
        "limits": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/quantity" }
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "periodSeconds"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 0, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "imageOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "description": "A digest must be a sha256 pin. The template re-checks this at render time; the schema catches it before that.",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    }
  },
  "properties": {
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "pathType", "service"],
                  "properties": {
                    "path": { "type": "string", "pattern": "^/" },
                    "pathType": {
                      "type": "string",
                      "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                    },
                    "service": { "type": "string", "enum": ["api", "admin", "web"] }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretName", "hosts"],
            "properties": {
              "secretName": { "type": "string", "minLength": 1 },
              "hosts": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/imageOverride" },
        "hookWeight": { "type": "integer", "minimum": -100, "maximum": 100 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resourceBlock" },
        "extraArgs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "probes", "service", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/imageOverride" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "port"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["liveness", "readiness"],
          "properties": {
            "liveness": { "$ref": "#/definitions/probe" },
            "readiness": { "$ref": "#/definitions/probe" },
            "startup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "path": { "type": "string", "pattern": "^/" },
                "periodSeconds": { "type": "integer", "minimum": 1 },
                "failureThreshold": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "drainTimeoutMs": { "type": "integer", "minimum": 0 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resourceBlock" },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "probes", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/imageOverride" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["liveness", "readiness"],
          "properties": {
            "liveness": { "$ref": "#/definitions/probe" },
            "readiness": { "$ref": "#/definitions/probe" }
          }
        },
        "resources": { "$ref": "#/definitions/resourceBlock" },
        "autoscaling": { "$ref": "#/definitions/autoscaling" }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "probes", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/imageOverride" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["liveness", "readiness"],
          "properties": {
            "liveness": { "$ref": "#/definitions/probe" },
            "readiness": { "$ref": "#/definitions/probe" }
          }
        },
        "resources": { "$ref": "#/definitions/resourceBlock" },
        "autoscaling": { "$ref": "#/definitions/autoscaling" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "databaseUrl",
            "redisUrl",
            "s3AccessKey",
            "s3SecretKey",
            "csrfSecret"
          ],
          "properties": {
            "databaseUrl": { "type": "string", "minLength": 1 },
            "redisUrl": { "type": "string", "minLength": 1 },
            "s3AccessKey": { "type": "string", "minLength": 1 },
            "s3SecretKey": { "type": "string", "minLength": 1 },
            "csrfSecret": { "type": "string", "minLength": 1 },
            "adminEmail": { "type": "string" },
            "adminPassword": { "type": "string" }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "description": "Endpoints only. The chart never creates a database; see values.yaml for why an accidentally-installed one is worse than a failed install.",
      "properties": {
        "dsn": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket"],
      "properties": {
        "endpoint": { "type": "string" },
        "bucket": { "type": "string", "minLength": 1 },
        "region": { "type": "string" },
        "forcePathStyle": { "type": "boolean" }
      }
    },
    "publicUrl": { "type": "string", "minLength": 1 },
    "logLevel": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error"] },
    "logFormat": { "type": "string", "enum": ["json", "text"] },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "priorityClassName": { "type": "string" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "mountPath"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mountPath": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string" } }
    }
  }
}
