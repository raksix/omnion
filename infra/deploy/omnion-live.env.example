# Omnion — live development instance environment.
# Copy to /root/.omnion-live.env, keep the file at mode 0600 and adjust the secrets.
# The deploy script sources this file; it never enters the repository.

OMNION_ENV=production
OMNION_HOST=127.0.0.1
OMNION_PORT=4180
OMNION_DATABASE_URL=postgres://omnion:omnion@127.0.0.1:5433/omnion_live
OMNION_REDIS_URL=redis://127.0.0.1:6380
OMNION_LOG_FORMAT=json

# Observability (REQ-126). The defaults below are what the code uses when these are absent, so
# they are here as documentation rather than as requirements.
#
# `OMNION_DRAIN_TIMEOUT_MS` must fit inside pm2's `kill_timeout` for the API process, or a deploy
# SIGKILLs a process that is still draining — which loses the final telemetry flush and the
# shutdown summary line. The deploy script prints both numbers side by side for that reason.
# OMNION_DRAIN_TIMEOUT_MS=10000
# OMNION_EXPORTER_FLUSH=true
# OMNION_ALERTS_EVALUATOR=true

# First administrator, created only while the database has no accounts.
OMNION_ADMIN_EMAIL=owner@example.com
OMNION_ADMIN_PASSWORD=change-me

# Consumed by the web apps and by the deploy script's builds.
OMNION_API_URL=http://127.0.0.1:4180
OMNION_ADMIN_PORT=3180
OMNION_WEB_PORT=3280
